# Public Supabase keys — safe for the browser (protected by Row Level Security).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by api/ serverless functions). NEVER exposed to the
# browser — no VITE_ prefix. Leave empty here; set real values in Vercel env.
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
