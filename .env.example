# Public Supabase keys — safe for the browser (protected by Row Level Security).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by api/ serverless functions). NEVER exposed to the
# browser — no VITE_ prefix. Leave empty here; set real values in Vercel env.
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Google Places (New) — admin-only place-search proxy (api/places-search.js).
GOOGLE_PLACES_API_KEY=
# Shared secret guarding the daily RSS news cron (api/cron/ingest-news.js);
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
